    {
      "id": "percentage-0002",
      "globalNumber": 2,
      "topic": {
        "id": "percentage",
        "name": "Percentage"
      },
      "category": "Quantitative Aptitude",
      "question": "[Sample] A number is first increased by 20% and then decreased by 15%. What is the net percentage change in the number?",
      "questionHindi": "[नमूना] एक संख्या को पहले 20% बढ़ाया जाता है और फिर 15% घटाया जाता है। संख्या में शुद्ध प्रतिशत परिवर्तन क्या है?",
      "options": [
        {
          "id": "A",
          "text": "+2% increase"
        },
        {
          "id": "B",
          "text": "−2% decrease"
        },
        {
          "id": "C",
          "text": "+5% increase"
        },
        {
          "id": "D",
          "text": "+3% increase"
        }
      ],
      "correctAnswer": "A",
      "explanation": "Net change = 20 − 15 − (20 × 15)/100 = 5 − 3 = +2% increase.",
      "exam": {
        "name": "SSC CGL",
        "year": 2023,
        "shift": "Shift 2"
      },
      "difficulty": "Easy",
      "source": {
        "pdf": "Sample_percentage.pdf",
        "page": 1,
        "originalQuestionNumber": 2
      },
      "verificationStatus": "verified",
