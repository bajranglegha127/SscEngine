        "name": "Percentage"
      },
      "category": "Quantitative Aptitude",
      "question": "[Sample] In an election between two candidates, 10% of the voters did not cast their votes. The winning candidate secured 54% of the total voters in the voter list and won by 1,440 votes. Find the total number of voters.",
      "questionHindi": "[नमूना] दो उम्मीदवारों के बीच एक चुनाव में 10% मतदाताओं ने मतदान नहीं किया। विजयी उम्मीदवार को कुल मतदाता सूची के 54% मत मिले और वह 1,440 मतों से जीता। कुल मतदाताओं की संख्या ज्ञात कीजिए।",
      "options": [
        {
          "id": "A",
          "text": "7,500"
        },
        {
          "id": "B",
          "text": "8,000"
        },
        {
          "id": "C",
          "text": "9,000"
        },
        {
          "id": "D",
          "text": "10,000"
        }
      ],
      "correctAnswer": "B",
      "explanation": "Votes cast = 90%. Winner = 54%, Loser = 90% − 54% = 36%. Margin = 18% of total = 1440 => Total = 8000.",
      "exam": {
        "name": "SSC CHSL",
        "year": 2023,
        "shift": "Shift 1"
      },
      "difficulty": "Moderate",
      "source": {
        "pdf": "Sample_percentage.pdf",
        "page": 1,
        "originalQuestionNumber": 3
      },
      "verificationStatus": "verified",
