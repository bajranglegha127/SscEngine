    {
      "id": "percentage-0004",
      "globalNumber": 4,
      "topic": {
        "id": "percentage",
        "name": "Percentage"
      },
      "category": "Quantitative Aptitude",
      "question": "[Sample] If 35% of A is equal to 50% of B, and B is 2x% of A, then what is the value of x?",
      "questionHindi": "[नमूना] यदि A का 35%, B के 50% के बराबर है, और B, A का 2x% है, तो x का मान क्या है?",
      "options": [
        {
          "id": "A",
          "text": "35"
        },
        {
          "id": "B",
          "text": "70"
        },
        {
          "id": "C",
          "text": "25"
        },
        {
          "id": "D",
          "text": "40"
        }
      ],
      "correctAnswer": "A",
      "explanation": "B/A = 35/50 = 70/100 = 70%. Since 2x = 70, x = 35.",
      "exam": {
        "name": "SSC MTS",
        "year": 2023,
        "shift": "Shift 3"
      },
      "difficulty": "Easy",
      "source": {
        "pdf": "Sample_percentage.pdf",
        "page": 1,
        "originalQuestionNumber": 4
      },
      "verificationStatus": "verified",
      "isSample": true,
      "contentHash": "qh-55fec81a"
    },
    {
      "id": "percentage-0005",
