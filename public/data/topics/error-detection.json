        "name": "Error Detection & Grammar"
      },
      "category": "English",
      "question": "[Sample] Identify the segment with an error: \"One of the most important factor that leads to success is consistent practice.\"",
      "options": [
        {
          "id": "A",
          "text": "One of the most"
        },
        {
          "id": "B",
          "text": "important factor"
        },
        {
          "id": "C",
          "text": "that leads to success"
        },
        {
          "id": "D",
          "text": "is consistent practice"
        }
      ],
      "correctAnswer": "B",
      "explanation": "After \"One of the...\", the noun must be plural (\"important factors\").",
      "exam": {
        "name": "SSC CPO",
        "year": 2023,
        "shift": "Shift 1"
