        "name": "Error Detection & Grammar"
      },
      "category": "English",
      "question": "[Sample] Choose the correct improvement for the bracketed part: \"Hardly had we stepped out of the building (than it began) to pour heavily.\"",
      "options": [
        {
          "id": "A",
          "text": "when it began"
        },
        {
          "id": "B",
          "text": "then it began"
        },
        {
          "id": "C",
          "text": "as soon as it began"
        },
        {
          "id": "D",
          "text": "No improvement"
        }
      ],
      "correctAnswer": "A",
      "explanation": "\"Hardly / Scarcely ... when\" is the correct correlative conjunction pair.",
